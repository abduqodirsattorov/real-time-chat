# ─── Nova Chat & Call Platform — Environment Variables ─────────────────────────
# Bu faylni .env ga nusxa ko'chiring: cp .env.example .env
# Production'da BARCHA secret'larni o'zgartiring!

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_pass
POSTGRES_DB=nova_chat

# ─── Redis ──────────────────────────────────────────────────────────────────────
# (no auth for local dev — production'da AUTH o'rnating)

# ─── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ─── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=nova
RABBITMQ_PASS=nova_dev_pass

# ─── Meilisearch ────────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=nova_dev_master_key

# ─── JWT (auth-service) ─────────────────────────────────────────────────────────
# MUHIM: Production'da kamida 32 ta tasodifiy belgi!
JWT_SECRET=change_this_in_production_32_chars_min_xxx
JWT_REFRESH_SECRET=change_this_refresh_secret_32chars_xx

# ─── Centrifugo ─────────────────────────────────────────────────────────────────
CENTRIFUGO_HMAC_SECRET=centrifugo_hmac_secret_change_me_32chars
CENTRIFUGO_API_KEY=centrifugo_api_key_change_me

# ─── Nova SSO ───────────────────────────────────────────────────────────────────
NOVA_SHARED_SECRET=nova_sso_shared_secret_change_me_32chars

# ─── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=devsecret_change_me_32_chars_minimum_xx

# ─── FCM / APNs (notification-service) ─────────────────────────────────────────
# Lokal'da fayllar bo'lmasa, servis console log fallback ishlatadi
# secrets/fcm-service-account.json — Google Firebase console'dan olish
# secrets/apns.p8 — Apple Developer Portal'dan olish
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.nova.app
APNS_VOIP_TOPIC=com.nova.app.voip

# ─── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── General ────────────────────────────────────────────────────────────────────
NODE_ENV=development
