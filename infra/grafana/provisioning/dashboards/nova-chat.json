{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Nova Chat & Call Platform — asosiy metrikalar",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HTTP Xizmatlar",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "HTTP so'rovlar/s (xizmat bo'yicha)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 200}, {"color": "red", "value": 1000}] } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service)) * 1000",
          "legendFormat": "p95 {{service}}",
          "refId": "A"
        }
      ],
      "title": "HTTP latentlik p95 (ms)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (service)",
          "legendFormat": "{{service}} 5xx",
          "refId": "A"
        }
      ],
      "title": "5xx Xatolar/s",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Qo'ng'iroqlar",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "targets": [
        { "expr": "nova_calls_active_total", "legendFormat": "Aktiv", "refId": "A" },
        { "expr": "nova_calls_queued_total", "legendFormat": "Navbat", "refId": "B" },
        { "expr": "nova_calls_ringing_total", "legendFormat": "Jiringlayapti", "refId": "C" }
      ],
      "title": "Qo'ng'iroqlar holati",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(nova_call_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p50 suhbat davomiyligi",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nova_call_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95 suhbat davomiyligi",
          "refId": "B"
        }
      ],
      "title": "Suhbat davomiyligi (soniya)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Chat & Xabarlar",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 20,
      "targets": [
        {
          "expr": "sum(rate(nova_messages_sent_total[5m]))",
          "legendFormat": "Xabarlar/s",
          "refId": "A"
        }
      ],
      "title": "Yuborilgan xabarlar/s",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 21,
      "targets": [
        { "expr": "nova_rooms_active_total", "legendFormat": "Aktiv suhbatlar", "refId": "A" },
        { "expr": "nova_rooms_pending_total", "legendFormat": "Kutilmoqda", "refId": "B" }
      ],
      "title": "Suhbatlar holati",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 22,
      "targets": [
        { "expr": "nova_centrifugo_connections_total", "legendFormat": "WebSocket ulanishlar", "refId": "A" }
      ],
      "title": "Aktiv WebSocket ulanishlar",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Tizim resurslari",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 30,
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}} xotira",
          "refId": "A"
        }
      ],
      "title": "Jarayon xotirasi",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 31,
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "{{job}} CPU",
          "refId": "A"
        }
      ],
      "title": "CPU ishlatish",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "Loglar (Loki)",
      "type": "row"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
      "id": 40,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{container=~\"nova.*\"} |= \"error\" | json",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Xato loglari",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["nova-chat", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Nova Chat Platform",
  "uid": "nova-chat-main",
  "version": 1
}
