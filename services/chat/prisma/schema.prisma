generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  operator
  supervisor
  admin
  bot
  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted
  @@map("user_status")
}

enum UserLocale {
  uz
  ru
  @@map("user_locale")
}

enum RoomType {
  direct
  support
  transfer_consult
  @@map("room_type")
}

enum RoomStatus {
  open
  closed
  pending
  bot_handling
  @@map("room_status")
}

enum MessageType {
  text
  image
  video
  audio
  file
  voice
  system
  call_log
  bot_card
  bot_quick_reply
  @@map("message_type")
}

enum OperatorStatus {
  offline
  available
  busy
  away
  on_call
  in_transfer
  @@map("operator_status")
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  externalId String?    @unique @map("external_id") @db.VarChar(64)
  phone      String?    @unique @db.VarChar(32)
  email      String?    @unique @db.VarChar(255)
  fullName   String?    @map("full_name") @db.VarChar(255)
  avatarUrl  String?    @map("avatar_url")
  role       UserRole   @default(customer)
  status     UserStatus @default(active)
  locale     UserLocale @default(uz)
  metadata   Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("users")
}

// ── Product (tenant) ──────────────────────────────────────────────────────────

model Product {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(64)
  branding  Json     @default("{}")
  settings  Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rooms     Room[]
  customers Customer[]

  @@map("products")
}

// ── Room ──────────────────────────────────────────────────────────────────────

model Room {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId          String?    @map("product_id") @db.Uuid
  type               RoomType   @default(support)
  status             RoomStatus @default(pending)
  title              String?    @db.VarChar(255)
  customerId         String?    @map("customer_id") @db.Uuid
  operatorId         String?    @map("operator_id") @db.Uuid
  previousOperatorId String?    @map("previous_operator_id") @db.Uuid
  lastMessageAt      DateTime?  @map("last_message_at") @db.Timestamptz()
  botHandled         Boolean    @default(false) @map("bot_handled")
  escalatedAt        DateTime?  @map("escalated_at") @db.Timestamptz()
  metadata           Json       @default("{}")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  closedAt           DateTime?  @map("closed_at") @db.Timestamptz()

  product  Product?    @relation(fields: [productId], references: [id])
  members  RoomMember[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([customerId])
  @@index([productId])
  @@map("rooms")
}

// ── RoomMember ─────────────────────────────────────────────────────────────────

model RoomMember {
  roomId  String    @map("room_id") @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  leftAt  DateTime? @map("left_at") @db.Timestamptz()
  muted   Boolean   @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_members")
}

// ── Message — TimescaleDB hypertable (composite PK: id + created_at) ──────────

model Message {
  id        String      @db.Uuid
  roomId    String      @map("room_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  type      MessageType @default(text)
  content   String?
  replyToId String?     @map("reply_to_id") @db.Uuid
  editedAt  DateTime?   @map("edited_at") @db.Timestamptz()
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz()
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  @@id([id, createdAt])
  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("messages")
}

// ── MessageReceipt ────────────────────────────────────────────────────────────

model MessageReceipt {
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()
  readAt      DateTime? @map("read_at") @db.Timestamptz()

  @@id([messageId, userId])
  @@map("message_receipts")
}

// ── Attachment ────────────────────────────────────────────────────────────────

model Attachment {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  storageKey   String   @map("storage_key") @db.VarChar(512)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  fileName     String   @map("file_name") @db.VarChar(512)
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  durationMs   Int?     @map("duration_ms")
  thumbnailKey String?  @map("thumbnail_key") @db.VarChar(512)
  checksum     String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("attachments")
}

// ── SystemMessageTemplate ─────────────────────────────────────────────────────

model SystemMessageTemplate {
  key        String   @id @db.VarChar(64)
  templateUz String   @map("template_uz")
  templateRu String   @map("template_ru")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("system_message_templates")
}

// ── Customer (mijoz profil) ───────────────────────────────────────────────────

model Customer {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  externalUid String?  @map("external_uid") @db.VarChar(128)
  profileData Json     @default("{}") @map("profile_data")
  notes       String?
  tags        String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@unique([productId, externalUid])
  @@index([productId])
  @@index([userId])
  @@map("customers")
}

// ── OperatorProduct ───────────────────────────────────────────────────────────

model OperatorProduct {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([userId, productId])
  @@index([userId])
  @@map("operator_products")
}

// ── OperatorState ─────────────────────────────────────────────────────────────

model OperatorState {
  userId             String         @id @map("user_id") @db.Uuid
  status             OperatorStatus @default(offline)
  activeChats        Int            @default(0) @map("active_chats")
  maxConcurrentChats Int            @default(5) @map("max_concurrent_chats")
  onCall             Boolean        @default(false) @map("on_call")
  currentCallId      String?        @map("current_call_id") @db.Uuid
  currentProductId   String?        @map("current_product_id") @db.Uuid
  lastStatusAt       DateTime       @default(now()) @map("last_status_at") @db.Timestamptz()
  skills             String[]       @default([])
  languages          UserLocale[]   @default([uz])
  isSupervisor       Boolean        @default(false) @map("is_supervisor")

  @@index([status])
  @@map("operator_states")
}
