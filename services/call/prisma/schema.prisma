generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CallDirection {
  inbound
  outbound
  internal

  @@map("call_direction")
}

enum CallStatus {
  initiating
  ringing
  queued
  connected
  on_hold
  transferring
  completed
  failed
  no_answer
  canceled

  @@map("call_status")
}

enum TransferType {
  cold
  warm

  @@map("transfer_type")
}

enum TransferStatus {
  initiated
  consulting
  completed
  failed
  canceled

  @@map("transfer_status")
}

enum RecordingStatus {
  starting
  active
  processing
  completed
  failed

  @@map("recording_status")
}

enum UserLocale {
  uz
  ru

  @@map("user_locale")
}

enum UserRole {
  admin
  supervisor
  operator
  customer
  bot

  @@map("user_role")
}

model User {
  id       String     @id @db.Uuid
  fullName String?    @map("full_name")
  phone    String?    @unique
  role     UserRole   @default(customer)
  locale   UserLocale @default(uz)

  @@map("users")
}

enum OperatorStatus {
  offline
  available
  busy
  away
  on_call
  in_transfer

  @@map("operator_status")
}

model OperatorState {
  userId             String         @id @map("user_id") @db.Uuid
  status             OperatorStatus
  activeChats        Int            @default(0) @map("active_chats")
  maxConcurrentChats Int            @default(5) @map("max_concurrent_chats")
  onCall             Boolean        @default(false) @map("on_call")
  languages          UserLocale[]
  skills             String[]

  @@map("operator_states")
}

model Call {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  callerId        String?       @map("caller_id") @db.Uuid
  calleeId        String?       @map("callee_id") @db.Uuid
  direction       CallDirection
  status          CallStatus    @default(initiating)
  livekitRoom     String?       @map("livekit_room")
  queueWaitMs     Int?          @map("queue_wait_ms")
  ringDurationMs  Int?          @map("ring_duration_ms")
  talkDurationMs  Int?          @map("talk_duration_ms")
  hangupCause     String?       @map("hangup_cause")
  hangupBy        String?       @map("hangup_by") @db.Uuid
  recordingId     String?       @map("recording_id") @db.Uuid
  metadata        Json          @default("{}")
  initiatedAt     DateTime      @default(now()) @map("initiated_at")
  answeredAt      DateTime?     @map("answered_at")
  endedAt         DateTime?     @map("ended_at")

  transfers  CallTransfer[]
  queue      CallQueue[]
  recordings Recording[]

  @@map("calls")
}

model CallTransfer {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  callId      String         @map("call_id") @db.Uuid
  fromOperator String        @map("from_operator") @db.Uuid
  toOperator  String         @map("to_operator") @db.Uuid
  type        TransferType
  status      TransferStatus @default(initiated)
  consultRoom String?        @map("consult_room")
  initiatedAt DateTime       @default(now()) @map("initiated_at")
  completedAt DateTime?      @map("completed_at")

  call        Call           @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_transfers")
}

model CallQueue {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  callId           String     @map("call_id") @db.Uuid
  priority         Int        @default(0) @db.SmallInt
  requiredSkills   String[]   @default([]) @map("required_skills")
  requiredLanguage UserLocale? @map("required_language")
  enqueuedAt       DateTime   @default(now()) @map("enqueued_at")
  assignedAt       DateTime?  @map("assigned_at")
  assignedTo       String?    @map("assigned_to") @db.Uuid

  call             Call       @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_queue")
}

model Recording {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  callId            String          @map("call_id") @db.Uuid
  startedBy         String          @map("started_by") @db.Uuid
  consentAnnounced  Boolean         @default(false) @map("consent_announced")
  status            RecordingStatus @default(starting)
  storageKey        String?         @map("storage_key")
  durationMs        Int?            @map("duration_ms")
  sizeBytes         BigInt?         @map("size_bytes")
  egressId          String?         @map("egress_id")
  startedAt         DateTime        @default(now()) @map("started_at")
  stoppedAt         DateTime?       @map("stopped_at")
  failedReason      String?         @map("failed_reason")

  call              Call            @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("recordings")
}
