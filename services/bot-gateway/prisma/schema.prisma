generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  supervisor
  operator
  customer
  bot

  @@map("user_role")
}

enum RoomStatus {
  open
  closed
  pending
  bot_handling

  @@map("room_status")
}

enum MessageType {
  text
  image
  video
  audio
  file
  voice
  system
  call_log
  bot_card
  bot_quick_reply

  @@map("message_type")
}

model BotConfig {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(128)
  type            String    @db.VarChar(32)
  enabled         Boolean   @default(false)
  config          Json      @default("{}")
  fallbackToHuman Boolean   @default(true) @map("fallback_to_human")
  handoffKeywords String[]  @default([]) @map("handoff_keywords")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("bot_configs")
}

model Room {
  id            String     @id @db.Uuid
  status        RoomStatus
  botHandled    Boolean    @default(false) @map("bot_handled")
  escalatedAt   DateTime?  @map("escalated_at")
  lastMessageAt DateTime?  @map("last_message_at")

  @@map("rooms")
}

model Message {
  id        String      @default(uuid()) @db.Uuid
  roomId    String      @db.Uuid @map("room_id")
  senderId  String      @db.Uuid @map("sender_id")
  type      MessageType @default(text)
  content   String?
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([id, createdAt])
  @@map("messages")
}

model User {
  id       String   @id @default(uuid()) @db.Uuid
  phone    String   @unique
  role     UserRole @default(customer)
  fullName String?  @map("full_name")

  @@map("users")
}
