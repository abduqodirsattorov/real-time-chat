generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  operator
  supervisor
  admin
  bot
  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted
  @@map("user_status")
}

enum UserLocale {
  uz
  ru
  @@map("user_locale")
}

enum OperatorStatus {
  offline
  available
  busy
  away
  on_call
  in_transfer
  @@map("operator_status")
}

model User {
  id        String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fullName  String?    @map("full_name") @db.VarChar(255)
  role      UserRole   @default(customer)
  status    UserStatus @default(active)
  locale    UserLocale @default(uz)

  operatorState OperatorState?

  @@map("users")
}

model OperatorState {
  userId             String         @id @map("user_id") @db.Uuid
  status             OperatorStatus @default(offline)
  activeChats        Int            @default(0) @map("active_chats")
  maxConcurrentChats Int            @default(5) @map("max_concurrent_chats")
  onCall             Boolean        @default(false) @map("on_call")
  currentCallId      String?        @map("current_call_id") @db.Uuid
  currentProductId   String?        @map("current_product_id") @db.Uuid
  lastStatusAt       DateTime       @default(now()) @map("last_status_at") @db.Timestamptz()
  skills             String[]       @default([])
  languages          UserLocale[]   @default([uz])
  isSupervisor       Boolean        @default(false) @map("is_supervisor")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("operator_states")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(128)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.Uuid
  payload    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("audit_logs")
}
